[Unit]
Description=Epimetheus Blue local DNS shield
After=network-online.target
Wants=network-online.target
ConditionUser=!root

[Service]
Type=simple
ExecStart=%h/.local/bin/blue dns
Restart=on-failure
RestartSec=5

# Port 53 is obtained from the cap_net_bind_service file capability installed by
# scripts/setup-system-dns.sh. NoNewPrivileges=yes would suppress that file
# capability during exec, so keep it disabled and bound the resulting process to
# that capability only.
NoNewPrivileges=no
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
KeyringMode=private
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
PrivateTmp=yes
PrivateNetwork=no
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
ReadWritePaths=%h/.local/share/blue
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
