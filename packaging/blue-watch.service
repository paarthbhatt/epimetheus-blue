[Unit]
Description=Epimetheus Blue realtime file protection
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/blue watch
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
KeyringMode=private
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
PrivateNetwork=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
ReadWritePaths=%h/.local/share/blue
# Containment needs write access to the default watched folders, not all of HOME.
# Custom roots require a reviewed service drop-in with matching writable paths.
ReadWritePaths=-%h/Downloads -%h/tmp
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
